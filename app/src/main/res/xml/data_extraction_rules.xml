<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31) backup/transfer rules. Model weights, cache, and the
  encrypted DB passphrase are excluded from both cloud backup and device
  transfer. See docs/00-CONSTITUTION.md (A2, P1).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="models/" />
        <exclude domain="cache" />
        <exclude domain="sharedpref" path="justsaid_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="models/" />
        <exclude domain="cache" />
        <exclude domain="sharedpref" path="justsaid_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
