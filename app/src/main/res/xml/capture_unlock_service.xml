<?xml version="1.0" encoding="utf-8"?>
<!-- Narrowest possible config: no window content access, minimal event mask, long
     notification timeout. The service exists only to lift Android's in-call
     microphone silencing for third-party apps (see CaptureUnlockAccessibilityService). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="10000"
    android:description="@string/capture_unlock_service_desc" />
