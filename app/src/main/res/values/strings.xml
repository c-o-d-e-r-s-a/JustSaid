    <string name="app_name">JustSaid</string>

    <!-- ── Legal / consent screen ── -->
    <string name="legal_title">Before you start</string>
    <string name="legal_body">JustSaid works entirely on this phone. It can listen to a phone call, write down what was said, and pull out the tasks and promises for you. Nothing is ever sent to the internet or to us.\n\nRecording calls is not allowed everywhere. In some places you must tell the other person that the call is being recorded, and in some places everyone must agree first.\n\nBy tapping \u201cI Agree\u201d you confirm that:\n\n\u2022 You will follow the call-recording laws where you live.\n\u2022 You will get the other person\u2019s permission when it is required.\n\u2022 You are responsible for how you use what JustSaid writes down.\n\nJustSaid stores everything privately on this phone only. You can delete it at any time.</string>
    <string name="legal_agree_button">I Agree</string>
    <string name="legal_agree_content_desc">Agree to the terms and continue</string>

